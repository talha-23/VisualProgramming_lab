        new("Architecture &", "Interior Design", "https://fiverr-res.cloudinary.com/q_auto,f_auto,w_255,dpr_1.0/v1/attachments/generic_asset/asset/798403fede61b8794968593f61942417-1721996236928/house-design.png"),
    };

    public record CategoryItem(string Title, string IconUrl);
    public record ServiceItem(string Title, string SubTitle, string ImageUrl);
}

<style>
    /* Fiverr Theme Colors */
    :root {
        --fiverr-primary: #1dbf73;
        --fiverr-text-dark: #222325;
        --fiverr-bg-dark: #401d2c; /* Correct dark red/maroon color from screenshot */
        --fiverr-card-green: #0d3b2e; /* The specific dark green for cards */
        --fiverr-card-beige: #efebe8; /* A light beige for the bottom of cards */
        --fiverr-nav-link-color: #62646a;
    }

    /* Navbar styling */
    .fiverr-navbar {
        font-family: 'Inter', sans-serif;
    }
    .fiverr-navbar .navbar-brand {
        display: flex;
        align-items: center;
    }
    .fiverr-navbar .nav-link {
        color: var(--fiverr-text-dark);
        font-weight: 600;
        font-size: 14px;
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
    }
    .search-form {
        max-width: 600px;
    }
    .fiverr-nav-link .dropdown-toggle {
        font-size: 14px;
        color: var(--fiverr-text-dark) !important;
    }
    .btn-outline-fiverr {
        border: 1px solid var(--fiverr-primary);
        border-radius: 4px;
        color: var(--fiverr-primary);
        font-size: 14px;
    }
    .btn-outline-fiverr:hover {
        background-color: var(--fiverr-primary);
        color: white;
    }

    /* Category Grid styling */
    .category-grid .card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .category-grid .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    }
    .category-grid .category-icon img {
        width: 48px;
        height: 48px;
    }
    .category-grid .category-title {
        font-size: 13px;
        color: var(--fiverr-text-dark);
        margin-top: 8px;
    }

    /* Popular Services Grid styling */
    .popular-services-grid .service-card {
        background-color: var(--fiverr-card-green); /* Dark green top */
        min-height: 250px;
        display: flex;
        flex-direction: column;
    }

    .popular-services-grid .card-img-overlay {
        justify-content: space-between;
    }

    .popular-services-grid .service-card .top-section {
        flex-grow: 1;
    }

    .popular-services-grid .service-card .bottom-section {
        background-color: var(--fiverr-card-beige); /* Beige bottom */
        height: 100px; /* Fixed height for image area */
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0 0 8px 8px; /* Rounded bottom corners */
    }

    .popular-services-grid .service-card .card-title {
        font-size: 1.25rem;
        color: white;
    }
    .popular-services-grid .service-card .card-subtitle {
        color: rgba(255, 255, 255, 0.7);
    }
    .popular-services-grid .service-card .service-icon {
        max-height: 80px; /* Control image size */
        object-fit: contain;
    }
    
    .popular-services-grid .service-grid-nav .btn {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Footer CTA styling */
    .footer-cta {
        background-color: var(--fiverr-bg-dark); /* Dark red background */
        font-family: 'Inter', sans-serif;
    }
    .footer-cta h2 {
        font-weight: 800;
        font-size: 3.5rem; /* Larger font size */
    }
    .footer-cta h2 .accent-text {
        font-family: 'Inter', sans-serif;
        font-weight: 300; /* Light accent text */
    }
    .footer-cta .btn {
        background-color: white;
        color: var(--fiverr-bg-dark);
        border: none;
        font-size: 1.2rem;
    }
    .footer-cta .btn:hover {
        background-color: #f8f9fa;
    }
</style>