        new("Website", "Development", "https://fiverr-res.cloudinary.com/q_auto,f_auto,w_255,dpr_1.0/v1/attachments/generic_asset/asset/798403fede61b8794968593f61942417-1721996236928/website-icon.png"),
        new("Video Editing", "", "https://fiverr-res.cloudinary.com/q_auto,f_auto,w_255,dpr_1.0/v1/attachments/generic_asset/asset/798403fede61b8794968593f61942417-1721996236922/video-icon.png"),
