        new("Graphics & Design", "https://img.fiverr.com/npm-assets/@fiverr/search-inline/graphics/design.435b62b.svg"),
        new("Digital Marketing", "https://img.fiverr.com/npm-assets/@fiverr/search-inline/graphics/marketing.c289a69.svg"),
        new("Writing & Translation", "https://img.fiverr.com/npm-assets/@fiverr/search-inline/graphics/writing.23a41e9.svg"),
        new("Video & Animation", "https://img.fiverr.com/npm-assets/@fiverr/search-inline/graphics/video.96c4296.svg"),
        new("AI Services", "https://img.fiverr.com/npm-assets/@fiverr/search-inline/graphics/ai.cf6f698.svg"),
